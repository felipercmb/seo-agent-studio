# Opcional. Vazio: descoberta de termos e diagnóstico sem posições do Google.
# Use apenas a chave de uma conta SerpApi Free, sem plano pago nem recarga.
SERPAPI_KEY=

# O servidor aceita conexões somente do próprio computador (127.0.0.1).
PORT=8794

# Caminho relativo à pasta do projeto. Não publique esta pasta.
DATA_DIR=./data

# Demanda histórica opcional. Desligada por padrão; requer acesso Google Ads
# aprovado para a conta técnica. Não cria campanhas nem altera orçamentos.
GOOGLE_ADS_DEMANDA=0
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
